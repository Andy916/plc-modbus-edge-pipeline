        "id": "ea20bbc5e6ec813c",
        "type": "function",
        "z": "c17b4e98c6e2f115",
        "name": "function 1",
        "func": "let rawLevel = msg.payload;\n\n// JavaScript Transformation: Determine system state\nlet statusText = \"NORMAL\";\nlet alarmActive = false;\n\nif (rawLevel > 85) {\n    statusText = \"HIGH LEVEL WARNING!\";\n    alarmActive = true;\n}\n\n// Output 1 format for Local HMI Gauge (just the number)\nlet hmiMsg = { payload: rawLevel };\n\n// Output 2 format for MQTT / Tier 4 Enterprise JSON payload\nlet mqttMsg = {\n    payload: {\n        device: \"Tank_System_01\",\n        register: \"MHR1\",\n        tank_level_pct: rawLevel,\n        status: statusText,\n        alarm: alarmActive,\n        timestamp: Date.now()\n    }\n};\n\nreturn [hmiMsg, mqttMsg];",
